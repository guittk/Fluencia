{
  "hosting": {
    "site": "fluencia",
    "public": ".",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "*.md", "CNAME"],
    "headers": [
      { "source": "**/*.@(js|css|webmanifest)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
